{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrianBusby/provenance-engine/project/schema/shared-project-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "path", "default_ref"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "default_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
