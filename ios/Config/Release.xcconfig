// Release.xcconfig
// Release configuration for iOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = dev.bmux.app.beta
DEVELOPMENT_TEAM = 7WLXT3NR37

// Distinguish the TestFlight beta on-device from a future App Store "bmux"
// (overrides PRODUCT_DISPLAY_NAME = bmux from Shared.xcconfig). Debug stays "bmux".
PRODUCT_DISPLAY_NAME = bmux BETA

// TestFlight/App Store builds use production APNs. Debug keeps
// Config/bmux.entitlements from Shared.xcconfig.
CODE_SIGN_ENTITLEMENTS = Config/bmux-release.entitlements

// Release (TestFlight beta + App Store) pairing scheme. Dev builds register
// bmux-ios-dev instead, so the Camera app routes each channel's QR to the
// matching build. Keep in sync with CmxPairingURLScheme.release.
BMUX_IOS_URL_SCHEME = bmux-ios
